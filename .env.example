# --- Required ---------------------------------------------------------------
# 32 random bytes, hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# --- Core --------------------------------------------------------------------
# SQLite file (relative to apps/api when run via npm scripts)
DATABASE_URL=file:./data/zodypay.db
# Optional. Leave empty to run background jobs inside the API process.
# Set it (and run `npm run dev:worker`) to move jobs to a separate BullMQ worker.
REDIS_URL=
# Public URL of the web app (used in checkout_url)
WEB_URL=http://localhost:3000
PORT=4000
# Set true behind HTTPS in production
COOKIE_SECURE=false
# Set true when running behind a reverse proxy / load balancer (needed for correct customer IPs)
TRUST_PROXY=false
ALLOW_REGISTRATION=true
PAYMENT_TTL_MINUTES=60
# Development only: allow webhooks to localhost/private IPs
ALLOW_PRIVATE_WEBHOOKS=false
# Seconds per simulated stage for test-mode swaps
MOCK_STAGE_SECONDS=15

# --- Live exchange providers (a provider is enabled when its credentials are set) ---
# https://sideshift.ai/account  → Account ID + Private Key
SIDESHIFT_SECRET=
SIDESHIFT_AFFILIATE_ID=
# https://changenow.io/affiliate → API key (partner fee is set in the ChangeNOW dashboard)
CHANGENOW_API_KEY=
# https://ff.io/user/apikey
FIXEDFLOAT_API_KEY=
FIXEDFLOAT_API_SECRET=
FIXEDFLOAT_REFCODE=
FIXEDFLOAT_AFFTAX=

# Price feed for non-stablecoin settlement (optional demo key raises rate limits)
COINGECKO_API_KEY=
